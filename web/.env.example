# ODrop Web — ortam değişkenleri (web/.env olarak kopyala, chmod 600)
PORT=3000

# Davet linkleri / gelen kutusu: /inbox sayfasına ve Windows uygulamasına girilen anahtar
ODROP_OWNER_KEY=uzun-rastgele-bir-anahtar
# Davet sayfasında görünen ad
ODROP_OWNER_NAME=Özcan

# coturn (use-auth-secret) — /etc/turnserver.conf içindeki static-auth-secret ile aynı olmalı
TURN_SECRET=
TURN_HOST=odrop.ozcan.work
# 5349 (TURN over TLS) kapalıysa 0 yap
TURN_TLS=1
